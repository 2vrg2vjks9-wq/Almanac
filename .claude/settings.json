{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/tools/safety_check.py --hook",
            "timeout": 60,
            "statusMessage": "Running safety check"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/tools/after_publish.sh",
            "timeout": 120,
            "statusMessage": "Pushing to GitHub"
          }
        ]
      }
    ]
  }
}
